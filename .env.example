# -----------------------------------------------------------------------------
# Environment variables
#
# This app needs NO custom env vars to run. The client connects to Socket.IO
# with a bare io() on the same origin, so there is no API URL to configure.
# The two variables below are read from the platform, not required from you.
# -----------------------------------------------------------------------------

# Port the custom server listens on. Railway (and most PaaS hosts) inject this
# automatically. Defaults to 3000 locally if unset.
# PORT=3000

# Set to "production" in deployment so server.js boots Next.js in production mode
# (serving the prebuilt .next output instead of the dev compiler). Railway sets
# this by default; leave it unset for local `npm run dev`.
# NODE_ENV=production
